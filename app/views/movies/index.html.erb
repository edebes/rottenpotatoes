<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<div id="movies">
  <table>
    <thead>
      <tr>
        <th><%= link_to "Title", sort_table_movies_path(column: "title", direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Rating", sort_table_movies_path(column: "rating", direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Release date", sort_table_movies_path(column: "release_date", direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.rating %></td>
          <td><%= movie.release_date %></td>
          <td><%= link_to "Show this movie", movie_path(movie, column: params[:column], direction: params[:direction]) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= will_paginate @movies, params: {column: params[:column], direction: params[:direction]} %>
</div>

<%= link_to "New movie", new_movie_path(column: params[:column], direction: params[:direction]) %>
