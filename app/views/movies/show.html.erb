<p style="color: green"><%= notice %></p>

<%= render @movie %>

<div>
  <%= link_to "Edit this movie", edit_movie_path(@movie, column: params[:column] || "title", direction: params[:direction] || "asc") %> |
  <%= link_to "Back to movies", sort_table_movies_path(column: params[:column] || "title", direction: params[:direction] || "asc") %>

  <%= button_to "Destroy this movie", movie_path(@movie, column: params[:column] || "title", direction: params[:direction] || "asc"), method: :delete %>
</div>
